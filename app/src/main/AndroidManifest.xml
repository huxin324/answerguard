<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 后台常驻通知 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 前台服务：保证 App 被切到后台后计时仍然运行 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- 悬浮窗：允许在任何 App 上面弹出答题窗口（核心权限） -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- 申请「电池优化白名单」，防止后台守护服务被系统杀掉 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- 精确闹钟：到点弹题由系统闹钟驱动，进程被冻结/杀掉也能准时唤醒（核心机制） -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- 开机自启：重启手机后自动恢复守护 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:allowBackup="true"
        android:label="答题守护"
        android:supportsRtl="true"
        android:theme="@style/Theme.AnswerLock">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            答题界面已改为悬浮窗方案（WindowManager 直接绘制，不启动 Activity），
            不再需要 QuizActivity：华为/鸿蒙限制「后台启动界面」会导致弹不出来，
            悬浮窗方案只要「显示在其他应用上层」权限即可，且上划任务列表滑不掉。
        -->

        <receiver
            android:name=".RestartReceiver"
            android:exported="false" />

        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <service
            android:name=".QuizService"
            android:exported="false" />
    </application>

</manifest>
