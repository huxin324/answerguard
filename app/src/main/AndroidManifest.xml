<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 后台常驻通知 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 前台服务：提高进程优先级 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- 前台服务类型 mediaPlayback：让守护进程像音乐 App 一样常驻，不被系统冻结 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- 唤醒锁：保持静音播放通道，防止后台被冻结（v1.7 核心） -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- 悬浮窗：允许在任何 App 上面弹出答题窗口（核心权限） -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- 电池优化白名单，防止后台服务被系统杀掉 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- 精确闹钟（第二重保险） -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- 安卓 13+ 自动授予的精确闹钟权限：保证「复活闹钟」不会被系统延后 -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <!-- 开机自启 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:allowBackup="true"
        android:label="答题守护"
        android:supportsRtl="true"
        android:theme="@style/Theme.AnswerLock">

        <!--
            excludeFromRecents：让「答题守护」不显示在最近任务里。
            孩子上滑看不到这张卡片，就没法靠划卡片把守护划掉。
            家长仍可从桌面图标正常打开。
        -->
        <activity
            android:name=".MainActivity"
            android:excludeFromRecents="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            答题界面是 WindowManager 悬浮窗（不启动 Activity）：
            华为/鸿蒙限制「后台启动界面」，Activity 弹不出来；悬浮窗只要
            「显示在其他应用上层」权限即可，且上划任务列表滑不掉。
        -->

        <!--
            无障碍守护服务（v1.6 核心）：
            由系统绑定并常驻，不会被鸿蒙「后台冻结」，用它的 Handler 每秒心跳来计时，
            从而做到离开 App 也能准时弹题。
        -->
        <service
            android:name=".GuardAccessibilityService"
            android:exported="true"
            android:label="答题守护"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <receiver
            android:name=".RestartReceiver"
            android:exported="false" />

        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- stopWithTask=false：任务被划掉也不停止服务，配合 onTaskRemoved 立刻重弹 -->
        <service
            android:name=".QuizService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback"
            android:stopWithTask="false" />
    </application>

</manifest>
