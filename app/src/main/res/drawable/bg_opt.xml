<?xml version="1.0" encoding="utf-8"?>
<!--
    电视版选项 / 键盘按键背景（遥控器焦点是第一要务）：
    聚焦 = 亮蓝底 + 白描边（2dp，电视上隔着 2 米也要一眼看清焦点在哪）
    默认 = 深色底 + 细描边
    答题后的对错着色不走这里，代码会换成 bg_opt_ok / bg_opt_no。
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <solid android:color="#2F6BFF" />
            <corners android:radius="14dp" />
            <stroke
                android:width="2dp"
                android:color="#FFFFFF" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#1E4FA8" />
            <corners android:radius="14dp" />
            <stroke
                android:width="2dp"
                android:color="#FFFFFF" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#1C2740" />
            <corners android:radius="14dp" />
            <stroke
                android:width="1dp"
                android:color="#33415F" />
        </shape>
    </item>
</selector>
