<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#CC0D1220"
    android:gravity="center">

    <!-- 答题卡片 -->
    <ScrollView
        android:id="@+id/quizBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_margin="20dp"
        android:background="@drawable/bg_card">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- 顶部一行：科目 + 右上角「紧急解锁」（家长紧急用手机时跳过解题） -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/subjectTv"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="📘 数学 · 答对才能继续玩"
                    android:textColor="#2F6BFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/emergencyBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_field"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingStart="10dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="6dp"
                    android:text="🆘 紧急解锁"
                    android:textColor="#B26A00"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- 答题主体（打开紧急解锁面板时整块隐藏） -->
            <LinearLayout
                android:id="@+id/quizPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

            <TextView
                android:id="@+id/penaltyTv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="⚠️ 答错加题"
                android:textColor="#E5484D"
                android:textSize="13sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/timerTv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="⏳ 剩余作答时间"
                android:textColor="#F59E0B"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/questionTv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="14dp"
                android:text="题目"
                android:textColor="#1F2430"
                android:textSize="22sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/optionsBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/feedbackTv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:textColor="#1F2430"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/explainTv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="#F2F6FF"
                android:lineSpacingExtra="4dp"
                android:padding="12dp"
                android:textColor="#1F2430"
                android:textSize="13sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/replayBtn"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="#EEF2FF"
                android:text="🔊 再听一遍讲解"
                android:textColor="#2F6BFF"
                android:visibility="gone" />
            </LinearLayout>

            <!-- 紧急解锁面板：输家长密码 → 本轮作废 + 10 分钟免打扰 -->
            <LinearLayout
                android:id="@+id/emgBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🆘 家长紧急解锁"
                    android:textColor="#1F2430"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="#FFF4E5"
                    android:lineSpacingExtra="3dp"
                    android:padding="12dp"
                    android:text="输入家长密码后：\n· 本轮题目立即作废，不用再答\n· 接下来 10 分钟不弹题、不计使用时长\n· 10 分钟后自动恢复守护"
                    android:textColor="#8C4038"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/emgPwd"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_field"
                    android:gravity="center"
                    android:hint="家长密码"
                    android:inputType="numberPassword"
                    android:maxLength="8"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/emgErrTv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="密码不对"
                    android:textColor="#C0392B"
                    android:textSize="12sp"
                    android:visibility="gone" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/emgCancelBtn"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_weight="1"
                        android:backgroundTint="#F0F2F6"
                        android:text="取消"
                        android:textColor="#7A8194" />

                    <Button
                        android:id="@+id/emgOkBtn"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:backgroundTint="#F59E0B"
                        android:text="确认解锁"
                        android:textColor="#FFFFFF" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- 锁屏页 -->
    <LinearLayout
        android:id="@+id/lockBox"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#10162A"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔒"
            android:textSize="56sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="今日时间已用完"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="去阅读、运动或休息一下吧！\n想继续使用需要家长输入密码解锁。"
            android:textColor="#AAB3C9"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/lockPwd"
            android:layout_width="220dp"
            android:layout_height="48dp"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:hint="请输入家长密码"
            android:inputType="textPassword"
            android:maxLength="8"
            android:textColor="#FFFFFF"
            android:textColorHint="#7A8194" />

        <Button
            android:id="@+id/unlockBtn"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:paddingStart="40dp"
            android:paddingEnd="40dp"
            android:backgroundTint="#2F6BFF"
            android:text="解锁"
            android:textColor="#FFFFFF" />
    </LinearLayout>
</FrameLayout>
